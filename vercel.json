{
  "regions": ["bom1"],
  "buildCommand": "pnpm --filter=@verve/web build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "pnpm install",
  "devCommand": "pnpm --filter=@verve/web dev",
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "*/14 * * * *"
    }
  ]
}
